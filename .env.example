# Copy this file to .env and fill in the values. Never commit .env.

# Bot token from the Discord Developer Portal (Bot → Reset Token).
DISCORD_TOKEN=

# Application ID from the Discord Developer Portal (General Information).
DISCORD_CLIENT_ID=

# Optional: fatal | error | warn | info | debug | trace (default: info)
LOG_LEVEL=info

# Optional: path to the guild allowlist config (default: config.json)
BOT_CONFIG_PATH=config.json

# Optional: path to the loot database, created if missing (default: data/loot.sqlite)
LOOT_DB_PATH=data/loot.sqlite

# Optional: path to the raids database (absences, reminders), created if missing
# (default: data/raids.sqlite)
RAIDS_DB_PATH=data/raids.sqlite

# Optional: each server's Raid-Helper API key, from running Raid-Helper's /apikey in that server.
# A key turns raid sign-ups on for its server; Officers then set them up with /raidsetup.
# A JSON object of server ID → key, in single quotes so a "#" in a key is not read as a comment.
# RAID_HELPER_API_KEYS='{"000000000000000000":"API_KEY"}'
